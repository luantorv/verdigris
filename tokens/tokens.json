{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "version": "0.1.0",
  "palette": {
    "black": { "$type": "color", "$value": "#141310" },
    "white": { "$type": "color", "$value": "#f4f1f0" },
    "grey": { "$type": "color", "$value": "#c7afab" },
    "dark-blue": { "$type": "color", "$value": "#5589f7" },
    "light-blue": { "$type": "color", "$value": "#2ea1c7" },
    "green": { "$type": "color", "$value": "#17c0ae" },
    "sand": { "$type": "color", "$value": "#e3be3c" },
    "red": { "$type": "color", "$value": "#f23a50" },
    "lavender": { "$type": "color", "$value": "#ae9afb" }
  },
  "color": {
    "bg": { "$type": "color", "$value": "{palette.black}" },
    "surface": { "$type": "color", "$value": "#1b1917" },
    "surface-raised": { "$type": "color", "$value": "#24201e" },
    "surface-active": { "$type": "color", "$value": "#302b29" },
    "border": { "$type": "color", "$value": "#3a3432" },
    "border-strong": { "$type": "color", "$value": "#554c48" },
    "text": { "$type": "color", "$value": "{palette.white}" },
    "text-muted": { "$type": "color", "$value": "{palette.grey}" },
    "text-subtle": { "$type": "color", "$value": "#958985" },
    "accent": { "$type": "color", "$value": "{palette.green}" },
    "on-accent": { "$type": "color", "$value": "{palette.black}" },
    "info": { "$type": "color", "$value": "{palette.light-blue}" },
    "structure": { "$type": "color", "$value": "{palette.dark-blue}" },
    "warning": { "$type": "color", "$value": "{palette.sand}" },
    "danger": { "$type": "color", "$value": "{palette.red}" },
    "highlight": { "$type": "color", "$value": "{palette.lavender}" }
  },
  "space": {
    "1": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
    "2": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "3": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
    "4": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
    "6": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
    "8": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },
    "12": { "$type": "dimension", "$value": { "value": 48, "unit": "px" } },
    "16": { "$type": "dimension", "$value": { "value": 64, "unit": "px" } }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": { "value": 2, "unit": "px" } },
    "md": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
    "lg": { "$type": "dimension", "$value": { "value": 6, "unit": "px" } }
  },
  "border": {
    "width": { "$type": "dimension", "$value": { "value": 1, "unit": "px" } }
  },
  "control": {
    "sm": { "$type": "dimension", "$value": { "value": 28, "unit": "px" } },
    "md": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },
    "lg": { "$type": "dimension", "$value": { "value": 36, "unit": "px" } }
  },
  "icon": {
    "sm": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
    "md": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } },
    "lg": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } }
  },
  "font": {
    "family": { "$type": "fontFamily", "$value": ["JetBrains Mono", "Cascadia Code", "SFMono-Regular", "Consolas", "monospace"] },
    "size-xs": { "$type": "dimension", "$value": { "value": 11, "unit": "px" } },
    "size-sm": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
    "size-md": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
    "size-lg": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
    "size-xl": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } },
    "size-2xl": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
    "size-metric": { "$type": "dimension", "$value": { "value": 28, "unit": "px" } },
    "weight-regular": { "$type": "fontWeight", "$value": 400 },
    "weight-medium": { "$type": "fontWeight", "$value": 500 },
    "weight-semibold": { "$type": "fontWeight", "$value": 600 }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": { "value": 100, "unit": "ms" } },
    "normal": { "$type": "duration", "$value": { "value": 140, "unit": "ms" } },
    "slow": { "$type": "duration", "$value": { "value": 160, "unit": "ms" } },
    "ease": { "$type": "cubicBezier", "$value": [0.2, 0.8, 0.2, 1] }
  }
}
